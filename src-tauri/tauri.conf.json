{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radefy Pharmacy",
  "version": "0.1.0",
  "identifier": "com.radefy.pharmacy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radefy Pharmacy",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Offline pharmacy management",
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
